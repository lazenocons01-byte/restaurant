{
  "name": "la-bella-cucina",
  "version": "1.0.0",
  "description": "La Bella Cucina — Fine Italian Dining Production Web App",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:vite\"",
    "dev:vite": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "db:init": "node server/db.js",
    "lint": "eslint src/js/**/*.js server/**/*.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "lucide-react": "^1.71.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "vite": "^5.2.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
