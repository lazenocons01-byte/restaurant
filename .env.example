# ── Server ──
PORT=3000
NODE_ENV=development

# ── Database ──
DB_PATH=./data/restaurant.db

# ── CORS ──
CORS_ORIGIN=http://localhost:5173

# ── Email (Nodemailer) — fill in your SMTP details ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
EMAIL_FROM="La Bella Cucina <no-reply@labellacucina.com>"
EMAIL_TO=reservations@labellacucina.com

# ── Rate limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
